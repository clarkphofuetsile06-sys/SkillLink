<section class="auth-page">
  <div class="wrap">
    <div class="auth-card">
      <div class="auth-side">
        <h2>Choose a new password.</h2>
        <p>Use at least 8 characters. After you save it, the reset link stops working.</p>
        <div class="mini"><i></i></div>
      </div>
      <div class="auth-form">
        <h1>New password</h1>
        @if (ViewBag.Invalid == true)
        {
          <div class="alert alert-error">This reset link is invalid, has expired or was already used.</div>
          <a class="btn btn-gold btn-block" asp-action="ForgotPassword">Ask for a new link</a>
        }
        else
        {
          @if (ViewBag.Error != null) { <div class="alert alert-error">@ViewBag.Error</div> }
          <form method="post" asp-action="ResetPassword">
            <input type="hidden" name="token" value="@ViewBag.Token">
            <div class="field"><label for="password">New password</label><input id="password" name="password" type="password" autocomplete="new-password" required></div>
            <button class="btn btn-gold btn-block">Save new password</button>
          </form>
        }
      </div>
    </div>
  </div>
</section>
