@model Provider
@{ var cats = (List<ServiceCategory>)ViewBag.Cats; var dists = (List<District>)ViewBag.Dists; var reqs = (List<ProviderRequest>)ViewBag.Reqs; }
<div class="page-hero"><div class="wrap"><h1>My profile</h1><p>Keep your details, skills and work photos up to date so customers can find you.</p></div></div>
<div class="wrap" style="padding-bottom:56px">
  @if (!Model.IsApproved) { <div class="alert alert-warn">Waiting for administrator approval. You will appear in search once approved.</div> }
  <div class="two-col">
    <form asp-action="Profile" method="post" class="panel">
      <h2>About you</h2>
      <div class="field"><label for="bio">About you and your work</label><textarea id="bio" name="bio">@Model.Bio</textarea></div>
      <div class="form-row two">
        <div class="field"><label for="districtId">District</label><select id="districtId" name="districtId">@foreach (var d in dists) { <option value="@d.DistrictId" selected="@(d.DistrictId == Model.DistrictId)">@d.Name</option> }</select></div>
        <div class="field"><label for="availabilityStatus">Availability</label><select id="availabilityStatus" name="availabilityStatus"><option>Available</option><option selected="@(Model.AvailabilityStatus == "Busy")">Busy</option></select></div>
      </div>
      <button class="btn btn-gold">Save profile</button>
      <a class="btn btn-outline" asp-controller="Account" asp-action="Profile">My account</a>
    </form>

    <div class="panel">
      <h2>My skills</h2>
      @foreach (var s in Model.Skills)
      {
        <div class="skill-row">
          <span class="chip">@s.Category?.Name</span>
          <form asp-action="UpdateSkill" method="post" class="skill-years">
            <input type="hidden" name="id" value="@s.SkillId">
            <label class="visually-hidden" for="yrs-@s.SkillId">Years of experience in @s.Category?.Name</label>
            <input id="yrs-@s.SkillId" name="years" type="number" min="0" max="60" value="@s.YearsExperience"><span class="muted">years</span>
            <button class="btn btn-outline btn-sm">Save</button>
          </form>
          <form asp-action="RemoveSkill" method="post" onsubmit="return confirm('Remove this skill from your profile?');"><input type="hidden" name="id" value="@s.SkillId"><button class="btn btn-danger btn-sm">Remove</button></form>
        </div>
      }
      @if (!Model.Skills.Any()) { <p class="muted">No skills added yet. Add at least one to receive requests.</p> }
      <h3 class="mt-3" style="font-size:1.05rem">Add a skill</h3>
      <form asp-action="AddSkill" method="post">
        <div class="form-row three" style="align-items:end">
          <div class="field"><label for="skillCategory">Service</label><select id="skillCategory" name="categoryId">@foreach (var c in cats) { <option value="@c.CategoryId">@c.Name</option> }</select></div>
          <div class="field"><label for="years">Years</label><input id="years" name="years" type="number" min="0" max="60" value="0"></div>
          <div class="field"><button class="btn btn-dark btn-block">Add skill</button></div>
        </div>
      </form>
    </div>
  </div>

  <h2 class="sub-title">My work photos</h2>
  <div class="panel">
    <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="upload-form">
      <div class="field"><label for="photo">Photo (JPG, PNG or WEBP, up to 2 MB)</label><input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" data-max="2097152" required></div>
      <div class="field"><label for="caption">Caption</label><input id="caption" name="caption" maxlength="120" placeholder="For example: Bathroom pipes replaced in Phakalane"></div>
      <div class="field"><button class="btn btn-gold btn-block">Upload photo</button></div>
    </form>
    <p class="muted small mb-0">You can keep up to 12 photos. Customers see them on your profile, and your first photo becomes your search card picture. You have @Model.Photos.Count.</p>
    @if (Model.Photos.Any())
    {
      <div class="gallery mt-2">
        @foreach (var ph in Model.Photos.OrderByDescending(x => x.UploadedAt))
        {
          <figure>
            <img src="/uploads/work/@ph.FileName" alt="@(ph.Caption ?? "Work photo")" loading="lazy">
            @if (!string.IsNullOrWhiteSpace(ph.Caption)) { <figcaption>@ph.Caption</figcaption> }
            <form asp-action="DeletePhoto" method="post" onsubmit="return confirm('Delete this photo?');"><input type="hidden" name="id" value="@ph.PhotoId"><button class="btn btn-danger btn-sm">Delete</button></form>
          </figure>
        }
      </div>
    }
  </div>

  <h2 class="sub-title">Service requests</h2>
  @foreach (var r in reqs)
  {
    <div class="rcard s-@r.Status">
      <div class="head">
        <div><span class="who">@r.ServiceRequest?.Category?.Name</span> <span class="muted">for @r.ServiceRequest?.Customer?.FullName</span></div>
        <span class="status @r.Status">@r.Status</span>
      </div>
      <div class="meta" style="margin-bottom:.5rem"><span>Phone: @r.ServiceRequest?.Customer?.PhoneNumber</span><span>Needed by @r.ServiceRequest?.PreferredDate.ToString("d MMM yyyy")</span></div>
      <div>@r.ServiceRequest?.JobDetails</div>
      @if (r.Status == "Pending")
      {
        <form asp-action="Respond" method="post" class="inline-form"><input type="hidden" name="id" value="@r.ProviderRequestId">
          <button name="accept" value="true" class="btn btn-ok btn-sm">Accept</button>
          <button name="accept" value="false" class="btn btn-danger btn-sm">Decline</button></form>
      }
      @if (r.Status == "Accepted")
      {
        <form asp-action="Complete" method="post" class="inline-form"><input type="hidden" name="id" value="@r.ProviderRequestId"><button class="btn btn-dark btn-sm">Mark job complete</button></form>
      }
    </div>
  }
  @if (!reqs.Any()) { <div class="empty"><strong>No requests yet</strong>Requests from customers will appear here.</div> }
</div>
