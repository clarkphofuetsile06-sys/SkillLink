<section class="auth-page">
  <div class="wrap">
    <div class="auth-card">
      <div class="auth-side">
        <h2>Welcome back.</h2>
        <p>Log in to manage your requests, your profile and your notifications.</p>
        <div class="mini"><i></i></div>
      </div>
      <form method="post" asp-action="Login" class="auth-form">
        <h1>Log in</h1>
        @if (ViewBag.Error != null) { <div class="alert alert-error">@ViewBag.Error</div> }
        <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required></div>
        <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
        <p class="mb-2" style="text-align:right"><a asp-action="ForgotPassword">Forgot your password?</a></p>
        <button class="btn btn-gold btn-block">Log in</button>
        <p class="center mt-2 mb-0">New here? <a asp-action="Register">Create an account</a></p>
      </form>
    </div>
  </div>
</section>
